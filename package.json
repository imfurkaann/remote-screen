{
  "name": "remote_screen",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "dashboard"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev -w backend",
    "dev:dashboard": "npm run dev -w dashboard",
    "lint": "npm run lint -w backend && npm run lint -w dashboard",
    "test": "npm run test -w backend && npm run test -w dashboard",
    "build": "npm run build -w backend && npm run build -w dashboard"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^8.24.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
