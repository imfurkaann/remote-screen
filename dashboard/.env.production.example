# Internal backend URL used by Next.js SSR route handlers (e.g. internal docker network or domain)
BACKEND_BASE_URL=http://backend:4100

# Publicly reachable backend URL used by the browser for Socket.IO connection
NEXT_PUBLIC_BACKEND_SOCKET_URL=https://api.yourdomain.com
