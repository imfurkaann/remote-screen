# Docker public address: change SERVER_HOST only when moving IP/domain.
# Host only, without scheme, port or path. See DOCKER.md.
SERVER_HOST=169.58.124.2
SERVER_SCHEME=http

# Runtime
NODE_ENV=development
BACKEND_PORT=4100
BACKEND_BASE_URL=http://localhost:4100
CORS_ORIGIN=http://localhost:3000

# Datastores
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_AUTO_INDEX=true # set false in production; create indexes via deployment migration
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_URI=mongodb://127.0.0.1:27017/remote_screen
REDIS_URL=redis://127.0.0.1:6379
PG_ENABLED=false
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=remote_screen
PG_USER=postgres
PG_PASSWORD=replace-with-a-secret
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PG_IDLE_TRANSACTION_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=35000
PG_MAX_USES=7500
READ_FROM_POSTGRES_PERCENTAGE=0

# Authentication - generate independent random values for every environment
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=remote-screen
JWT_AUDIENCE=remote-screen-clients
DEVICE_BOOTSTRAP_KEY=replace-with-at-least-32-random-characters
OPS_METRICS_TOKEN=replace-with-at-least-32-random-characters
# Dashboard browser WebSocket origin
BACKEND_PUBLIC_SOCKET_URL=https://api.example.com
NEXT_PUBLIC_BACKEND_SOCKET_URL=https://api.example.com

# Media storage. Use a shared persistent volume in multi-node deployments.
MEDIA_STORAGE_ROOT=./uploads
# Optional CDN/public origin that maps to MEDIA_STORAGE_ROOT
MEDIA_PUBLIC_BASE_URL=/uploads
MEDIA_MAX_FILE_BYTES=524288000

# Destructive maintenance scripts remain blocked unless both are set; never enable in production.
ALLOW_DESTRUCTIVE_DB_MAINTENANCE=false
DESTRUCTIVE_DB_CONFIRM=

# Manual retention maintenance (dry-run unless --apply is passed).
COMMAND_RETENTION_DAYS=180
PAIRING_AUDIT_RETENTION_DAYS=365
