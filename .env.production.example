# ==============================================================================
# Remote Screen - Production Environment Configuration Template
# Place actual values in .env.production on your cloud server (DO NOT COMMIT SECRETS)
# ==============================================================================

# Runtime Environment
NODE_ENV=production
BACKEND_PORT=4100
BACKEND_BASE_URL=https://api.yourdomain.com
CORS_ORIGIN=https://dashboard.yourdomain.com,https://yourdomain.com

# Datastores
# MongoDB Authentication (used by MONGO_INITDB in docker-compose)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=9443713e66a8232fe9c333c75eb8e2b6c1a76fb283883a0329ecf0c02d19c88e
# Production MongoDB Connection string (must include auth credentials)
MONGO_URI=mongodb://admin:9443713e66a8232fe9c333c75eb8e2b6c1a76fb283883a0329ecf0c02d19c88e@mongo:27017/remote_screen_prod?authSource=admin
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_AUTO_INDEX=false # Keep false in production; run migrations explicitly

# Redis Authentication
REDIS_PASSWORD=08cf56fd0e0f2fb3d5a51e47b8d3200fff7cf845055354eda2f327b3222d22d7
# Production Redis URL for socket adapters and caching (must include password)
REDIS_URL=redis://:08cf56fd0e0f2fb3d5a51e47b8d3200fff7cf845055354eda2f327b3222d22d7@redis:6379

# PostgreSQL (Optional - set PG_ENABLED=true if using PostgreSQL shadow/primary datastore)
PG_ENABLED=false
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=remote_screen_prod
PG_USER=postgres
PG_PASSWORD=CHANGE_THIS_TO_A_SECURE_STRONG_PASSWORD
PG_POOL_MAX=20
READ_FROM_POSTGRES_PERCENTAGE=0

# Authentication & Security Secrets (Generate 64+ char random strings)
# Command to generate key: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_THIS_TO_AT_LEAST_64_RANDOM_CHARACTERS_SECURE_SECRET_KEY
JWT_ISSUER=remote-screen-prod
JWT_AUDIENCE=remote-screen-clients
DEVICE_BOOTSTRAP_KEY=CHANGE_THIS_TO_AT_LEAST_64_RANDOM_CHARACTERS_BOOTSTRAP_KEY
OPS_METRICS_TOKEN=CHANGE_THIS_TO_AT_LEAST_64_RANDOM_CHARACTERS_METRICS_TOKEN

# Next.js Dashboard Browser WebSocket Target Origin
BACKEND_PUBLIC_SOCKET_URL=https://api.yourdomain.com
NEXT_PUBLIC_BACKEND_SOCKET_URL=https://api.yourdomain.com

# Media Storage (Must be mounted to a persistent volume in cloud deployments)
MEDIA_STORAGE_ROOT=./uploads
MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com/uploads
MEDIA_MAX_FILE_BYTES=524288000

# Maintenance Guardrails (Keep false in production)
ALLOW_DESTRUCTIVE_DB_MAINTENANCE=false
DESTRUCTIVE_DB_CONFIRM=

# Retention Maintenance
COMMAND_RETENTION_DAYS=180
PAIRING_AUDIT_RETENTION_DAYS=365
# Use false only for a temporary plain-HTTP deployment. Keep true behind HTTPS.
DASHBOARD_COOKIE_SECURE=true
